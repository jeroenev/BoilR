{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "BoilR's own window. Store sign-in windows get no access: they load remote pages.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-load-settings",
    "allow-discover-games",
    "allow-plan-sync",
    "allow-update-settings",
    "allow-list-platform-settings",
    "allow-update-platform-settings",
    "allow-update-platform-enabled",
    "allow-run-full-sync",
    "allow-list-backups",
    "allow-create-backup",
    "allow-restore-shortcuts",
    "allow-list-boilr-shortcuts",
    "allow-release-shortcut",
    "allow-list-steam-accounts",
    "allow-list-artwork",
    "allow-artwork-options",
    "allow-set-artwork",
    "allow-clear-artwork",
    "allow-artwork-game-match",
    "allow-set-artwork-game",
    "allow-find-missing-artwork",
    "allow-list-store-accounts",
    "allow-update-store-account",
    "allow-refresh-store-library",
    "allow-sign-out-store",
    "allow-submit-store-login",
    "allow-start-store-login",
    "allow-open-store-sign-in-page",
    "allow-rename-game",
    "allow-ping"
  ]
}
